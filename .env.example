# --- app ---
DATABASE_URL=sqlite:///data/calendar.db
SKYCAL_EPHE_PATH=data/ephe
# Base URL used when printing ICS subscription links (Fly: https://<app>.fly.dev)
PUBLIC_BASE_URL=http://localhost:8000
# Timezone the scheduler runs in (nightly recompute at 02:00 local)
APP_TIMEZONE=America/New_York
SCHEDULER_ENABLED=true
# Phase 1 has no auth: every request acts as this user (created on first boot).
DEFAULT_USER_EMAIL=me@example.com

# --- your chart (read by scripts/seed_me.py) ---
ME_NAME=Kedar
ME_BIRTH_DATE=YYYY-MM-DD
ME_BIRTH_TIME=HH:MM
ME_BIRTH_TZ=Region/City
ME_BIRTH_PLACE="City, Country"
ME_BIRTH_LAT=
ME_BIRTH_LON=
ME_TIME_KNOWN=exact
ME_TIMEZONE=America/New_York
